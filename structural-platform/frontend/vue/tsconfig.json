    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"], "strict": true, "allowJs": true,
    "checkJs": false, "skipLibCheck": true, "noEmit": true,
    "esModuleInterop": true, "resolveJsonModule": true,
