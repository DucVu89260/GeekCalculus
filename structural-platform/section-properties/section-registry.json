  "properties": [
    {
      "key": "geometric.area",
      "symbol": "A",
      "unit": "mm2",
      "expression": "A = ∫_Ω dA = Σ A_i",
      "reference_ids": [
        "geometric_integrals"
      ]
    },
    {
      "key": "geometric.perimeter",
      "symbol": "P",
      "unit": "mm",
      "expression": "P = ∫_∂Ω ds (outer + inner boundaries)",
      "reference_ids": [
        "geometric_integrals"
      ]
    },
    {
      "key": "geometric.centroid_x",
      "symbol": "x̄",
      "unit": "mm",
      "expression": "x̄ = Σ(A_i x_i)/A",
      "reference_ids": [
        "geometric_integrals"
      ]
    },
    {
      "key": "geometric.centroid_y",
      "symbol": "ȳ",
      "unit": "mm",
      "expression": "ȳ = Σ(A_i y_i)/A",
      "reference_ids": [
        "geometric_integrals"
      ]
    },
    {
      "key": "elastic.ix",
      "symbol": "Ix",
      "unit": "mm4",
      "expression": "Ix = Σ[b_i h_i³/12 + A_i(y_i − ȳ)²]",
      "reference_ids": [
        "geometric_integrals"
      ]
    },
    {
      "key": "elastic.iy",
      "symbol": "Iy",
      "unit": "mm4",
      "expression": "Iy = Σ[h_i b_i³/12 + A_i(x_i − x̄)²]",
      "reference_ids": [
        "geometric_integrals"
      ]
    },
    {
      "key": "elastic.ixy",
      "symbol": "Ixy",
      "unit": "mm4",
      "expression": "Ixy = Σ A_i(x_i − x̄)(y_i − ȳ)",
      "reference_ids": [
        "geometric_integrals"
      ]
    },
    {
      "key": "elastic.sx_positive",
      "symbol": "Sx+",
      "unit": "mm3",
      "expression": "Sx+ = Ix/(H − ȳ)",
      "reference_ids": [
        "geometric_integrals"
      ]
    },
    {
      "key": "elastic.sx_negative",
      "symbol": "Sx−",
      "unit": "mm3",
      "expression": "Sx− = Ix/ȳ",
      "reference_ids": [
        "geometric_integrals"
      ]
    },
    {
      "key": "elastic.sy_positive",
      "symbol": "Sy+",
      "unit": "mm3",
      "expression": "Sy+ = Iy/(B − x̄)",
      "reference_ids": [
        "geometric_integrals"
      ]
    },
    {
      "key": "elastic.sy_negative",
      "symbol": "Sy−",
      "unit": "mm3",
      "expression": "Sy− = Iy/x̄",
      "reference_ids": [
        "geometric_integrals"
      ]
    },
    {
      "key": "elastic.rx",
      "symbol": "rx",
      "unit": "mm",
      "expression": "rx = √(Ix/A)",
      "reference_ids": [
        "geometric_integrals"
      ]
    },
    {
      "key": "elastic.ry",
      "symbol": "ry",
      "unit": "mm",
      "expression": "ry = √(Iy/A)",
      "reference_ids": [
        "geometric_integrals"
      ]
    },
    {
      "key": "plastic.pna_x",
      "symbol": "PNAx",
      "unit": "mm",
      "expression": "∫_{x ≤ xp} dA = A/2",
      "reference_ids": [
        "geometric_integrals"
      ]
    },
    {
      "key": "plastic.pna_y",
      "symbol": "PNAy",
      "unit": "mm",
      "expression": "∫_{y ≤ yp} dA = A/2",
      "reference_ids": [
        "geometric_integrals"
      ]
    },
    {
      "key": "plastic.zx",
      "symbol": "Zx",
      "unit": "mm3",
      "expression": "Zx = ∫_Ω |y − yp| dA",
      "reference_ids": [
        "geometric_integrals"
      ]
    },
    {
      "key": "plastic.zy",
      "symbol": "Zy",
      "unit": "mm3",
      "expression": "Zy = ∫_Ω |x − xp| dA",
      "reference_ids": [
        "geometric_integrals"
      ]
    },
    {
      "key": "principal.i_major",
      "symbol": "Imax",
      "unit": "mm4",
      "expression": "Imax = (Ix + Iy)/2 + √[((Ix − Iy)/2)² + Ixy²]",
      "reference_ids": [
        "geometric_integrals"
      ]
    },
    {
      "key": "principal.i_minor",
      "symbol": "Imin",
      "unit": "mm4",
      "expression": "Imin = (Ix + Iy)/2 − √[((Ix − Iy)/2)² + Ixy²]",
      "reference_ids": [
        "geometric_integrals"
      ]
    },
    {
      "key": "principal.major_axis_angle_degrees",
      "symbol": "θ",
      "unit": "deg",
      "expression": "θ = ½ atan2(−2Ixy, Ix − Iy), modulo 180°",
      "reference_ids": [
        "geometric_integrals"
      ]
    },
    {
      "key": "principal.orientation_status",
      "symbol": "Orientation",
      "unit": "1",
      "expression": "Indeterminate when Ix = Iy and Ixy = 0",
      "reference_ids": [
        "geometric_integrals"
      ]
    },
    {
      "key": "advanced.torsion_constant_j",
      "symbol": "J",
      "unit": "mm4",
      "expression": "J = 2∫_Ω φ dA, ∇²φ = −2; boundary conditions per geometry",
      "reference_ids": [
        "saint_venant",
        "vlasov"
      ]
    },
    {
      "key": "advanced.warping_constant_cw",
      "symbol": "Cw",
      "unit": "mm6",
      "expression": "Cw = ∫_Ω ω_n² dA (normalized warping about shear center)",
      "reference_ids": [
        "saint_venant",
        "vlasov"
      ]
    },
    {
      "key": "advanced.shear_center",
      "symbol": "SC",
      "unit": "mm",
      "expression": "SC: torque of shear flow is zero about (xs, ys); Δ = SC − centroid",
      "reference_ids": [
        "saint_venant",
        "vlasov"
      ]
    },
    {
      "key": "advanced.effective_shear_area",
      "symbol": "Ax/Ay",
      "unit": "mm2",
      "expression": "Ak = Vk² / ∫_Ω τk² dA; thin-wall: Ak = Vk² / ∫ qk²/t ds",
      "reference_ids": [
        "saint_venant",
        "vlasov"
      ]
    },
    {
      "key": "mechanics.geometry.polar_centroidal.inertia_mm4",
      "symbol": "Ip",
      "unit": "mm4",
      "expression": "Ip = Ix + Iy",
      "reference_ids": [
        "geometric_integrals"
      ]
    },
    {
      "key": "mechanics.geometry.polar_centroidal.radius_mm",
      "symbol": "rp",
      "unit": "mm",
      "expression": "rp = sqrt(Ip/A)",
      "reference_ids": [
        "geometric_integrals"
      ]
    },
    {
      "key": "mechanics.geometry.principal.major.extreme_positive_mm",
      "symbol": "cmajor+",
      "unit": "mm",
      "expression": "cmajor+ = max_material(v); u=X cos(theta)+Y sin(theta), v=-X sin(theta)+Y cos(theta)",
      "reference_ids": [
        "geometric_integrals"
      ]
    },
    {
      "key": "mechanics.geometry.principal.major.extreme_negative_mm",
      "symbol": "cmajor-",
      "unit": "mm",
      "expression": "cmajor- = min_material(v) (signed coordinate)",
      "reference_ids": [
        "geometric_integrals"
      ]
    },
    {
      "key": "mechanics.geometry.principal.major.elastic_modulus_positive_mm3",
      "symbol": "Smajor+",
      "unit": "mm3",
      "expression": "Smajor = Imax/abs(cmajor); use the stated positive/negative extreme",
      "reference_ids": [
        "geometric_integrals"
      ]
    },
    {
      "key": "mechanics.geometry.principal.major.elastic_modulus_negative_mm3",
      "symbol": "Smajor-",
      "unit": "mm3",
      "expression": "Smajor = Imax/abs(cmajor); use the stated positive/negative extreme",
      "reference_ids": [
        "geometric_integrals"
      ]
    },
    {
      "key": "mechanics.geometry.principal.major.radius_mm",
      "symbol": "rmajor",
      "unit": "mm",
      "expression": "rmajor = sqrt(Imax/A)",
      "reference_ids": [
        "geometric_integrals"
      ]
    },
    {
      "key": "mechanics.geometry.principal.major.plastic_neutral_coordinate_mm",
      "symbol": "pmajor",
      "unit": "mm",
      "expression": "integral_material(v <= pmajor) dA = A/2; local centroid coordinate",
      "reference_ids": [
        "geometric_integrals"
      ]
    },
    {
      "key": "mechanics.geometry.principal.major.plastic_modulus_mm3",
      "symbol": "Zmajor",
      "unit": "mm3",
      "expression": "Zmajor = integral_material(abs(v-pmajor)) dA",
      "reference_ids": [
        "geometric_integrals"
      ]
    },
    {
      "key": "mechanics.geometry.principal.minor.extreme_positive_mm",
      "symbol": "cminor+",
      "unit": "mm",
      "expression": "cminor+ = max_material(u); u=X cos(theta)+Y sin(theta), v=-X sin(theta)+Y cos(theta)",
      "reference_ids": [
        "geometric_integrals"
      ]
